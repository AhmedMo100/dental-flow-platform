# Database Connection (Prisma)
DATABASE_URL="postgresql://username:password@localhost:5432/dentflow_db?schema=public"

# Next Auth (Authentication Secrets)
NEXTAUTH_SECRET="your_next_auth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# Backend API URL (For Next.js to communicate with Express)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Environment Mode
NODE_ENV="development"